# Copy to .env and adjust to your MT5 install
# All paths are optional — defaults shown work for standard MT5 installations.

MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_METAEDITOR_PATH=C:\Program Files\MetaTrader 5\metaeditor64.exe
MT5_DATA_PATH=C:\Users\YOUR_USER\AppData\Roaming\MetaQuotes\Terminal
